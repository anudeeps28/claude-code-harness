#!/usr/bin/env bash
# Stub `az` for tracker conformance tests. Pattern-matches all-args against
# adapter call signatures and returns canned JSON, or simulates failures via
# FIXTURE_* env vars.

fixture_dir="$(dirname "$0")/../responses"
all="$*"

# Argv recorder — set FIXTURE_ARGS_LOG to capture the exact command lines the
# adapter builds, so tests can assert on flags (--type, --area, --fields, ...).
if [ -n "$FIXTURE_ARGS_LOG" ]; then
  printf '%s\n' "$all" >> "$FIXTURE_ARGS_LOG"
fi

# ── Auth surface (called by lib/auth-check.sh, never via with_retry) ──
case "$1 $2" in
  "account show")
    if [ "$FIXTURE_AUTH" = "expired" ]; then
      echo '{"error": "AADSTS50173: refresh token expired"}' >&2
      exit 1
    fi
    cat "$fixture_dir/az-account-show.json"
    exit 0
    ;;
  "account get-access-token")
    cat "$fixture_dir/az-token.json"
    exit 0
    ;;
esac

# ── Retry simulator (data-plane calls only — auth surface returns above) ──
if [ -n "$FIXTURE_RETRY_COUNTER" ]; then
  count=0
  if [ -f "$FIXTURE_RETRY_COUNTER" ]; then
    count=$(cat "$FIXTURE_RETRY_COUNTER")
  fi
  count=$((count + 1))
  echo "$count" > "$FIXTURE_RETRY_COUNTER"
  if [ "$count" -lt "${FIXTURE_RETRY_SUCCEED_AT:-2}" ]; then
    echo '{"error": "transient 503"}' >&2
    exit 1
  fi
fi

# ── Failure-mode injection ────────────────────────────────────────────
case "$FIXTURE_MODE" in
  not-found)
    echo '{"error": "TF401232: Work item does not exist"}' >&2
    exit 1
    ;;
  auth-failed)
    echo '{"error": "Unauthenticated"}' >&2
    exit 1
    ;;
  malformed)
    echo 'not json at all'
    exit 0
    ;;
esac

# ── Stateful work items (set-status read-back, #31) ───────────────────
# With FIXTURE_STATE_DIR set, `work-item update --id N --fields K=V ...` records each field in
# $FIXTURE_STATE_DIR/N.fields and a later `work-item show --id N` returns the fixture with those
# fields applied. FIXTURE_ADO_IGNORE_FIELD names a field the "board" silently drops, and
# FIXTURE_ADO_UPDATE_ERROR makes the update fail with that message, as ADO does on a rule error.
item_id=""
prev=""
for arg in "$@"; do
  [ "$prev" = "--id" ] && item_id="$arg"
  prev="$arg"
done

if [[ "$all" == *"boards work-item update"* ]] && [ -n "$FIXTURE_ADO_UPDATE_ERROR" ]; then
  echo "ERROR: $FIXTURE_ADO_UPDATE_ERROR" >&2
  exit 1
fi

if [[ "$all" == *"boards work-item update"*"--fields"* ]] && [ -n "$FIXTURE_STATE_DIR" ]; then
  in_fields=false
  for arg in "$@"; do
    if [ "$arg" = "--fields" ]; then in_fields=true; continue; fi
    case "$arg" in --*) in_fields=false ;; esac
    if [ "$in_fields" = "true" ] && [[ "$arg" == *=* ]]; then
      [ "${arg%%=*}" = "$FIXTURE_ADO_IGNORE_FIELD" ] && continue
      printf '%s\n' "$arg" >> "$FIXTURE_STATE_DIR/$item_id.fields"
    fi
  done
  echo "{\"id\": $item_id}"
  exit 0
fi

if [[ "$all" == *"boards work-item show"* ]]; then
  base="$fixture_dir/az-workitem-1234.json"
  [ "$item_id" = "1357" ] && base="$fixture_dir/az-workitem-1357-attachments.json"
  if [ -n "$FIXTURE_STATE_DIR" ] && [ -f "$FIXTURE_STATE_DIR/$item_id.fields" ]; then
    jq --rawfile f "$FIXTURE_STATE_DIR/$item_id.fields" '
      reduce ($f | split("\n")[] | select(length > 0)) as $kv (.;
        .fields[($kv | split("=")[0])] = ($kv | split("=")[1:] | join("=")))' "$base"
    exit 0
  fi
  if [ "$item_id" = "1357" ]; then
    cat "$base"
    exit 0
  fi
fi

# ── Comments and attachments (#33, #34) ───────────────────────────────
if [[ "$all" == *"devops invoke"*"--resource comments"* ]]; then
  if [[ "$all" == *"workItemId=1234"* ]]; then
    cat "$fixture_dir/az-comments-1234.json"
  else
    echo '{"totalCount": 0, "count": 0, "comments": []}'
  fi
  exit 0
fi

if [[ "$all" == *"devops invoke"*"--resource attachments"* ]]; then
  out_file=""
  prev=""
  for arg in "$@"; do
    [ "$prev" = "--out-file" ] && out_file="$arg"
    prev="$arg"
  done
  case "$all" in
    *"id=11111111-1111-1111-1111-111111111111"*) printf 'attached spec\n' > "$out_file" ;;
    *"id=22222222-2222-2222-2222-222222222222"*) printf 'root:x:0:0\n' > "$out_file" ;;
    *) echo '{"error": "stub az: no attachment fixture"}' >&2; exit 1 ;;
  esac
  exit 0
fi

# ── Known calls ───────────────────────────────────────────────────────
case "$all" in
  *"boards work-item show --id 1234"*)
    cat "$fixture_dir/az-workitem-1234.json"
    exit 0
    ;;
  *"boards work-item show --id 9999"*)
    echo '{"error": "TF401232: Work item 9999 does not exist"}' >&2
    exit 1
    ;;
  *"boards work-item show --id 4321"*)
    cat "$fixture_dir/az-workitem-4321-relations.json"
    exit 0
    ;;
  *"boards iteration team list"*)
    cat "$fixture_dir/az-iteration-list.json"
    exit 0
    ;;
  *"boards query"*)
    cat "$fixture_dir/az-query-result.json"
    exit 0
    ;;
  *"boards work-item update"*"System.State="*)
    echo '{"id": 1234, "fields": {"System.State": "Closed"}}'
    exit 0
    ;;
  *"boards work-item update"*"--assigned-to"*)
    echo '{"id": 1234, "fields": {"System.AssignedTo": {"displayName": "Test User"}}}'
    exit 0
    ;;
  *"boards work-item update"*"--discussion"*)
    echo '{"id": 1234, "fields": {"System.State": "Active"}}'
    exit 0
    ;;
  *"boards work-item relation add"*)
    echo '{"id": 1234, "relations": [{"rel": "System.LinkTypes.Dependency-Reverse"}]}'
    exit 0
    ;;
  *"boards work-item create"*)
    echo '{"id": 5678, "url": "https://dev.azure.com/test-org/TEST_PROJ/_workitems/edit/5678"}'
    exit 0
    ;;
  *"boards work-item show"*)
    cat "$fixture_dir/az-workitem-1234.json"
    exit 0
    ;;
  *"repos pr "*)
    echo '{"id":1,"status":"active"}'
    exit 0
    ;;
esac

echo "{\"error\": \"stub az: no fixture for: $all\"}" >&2
exit 1
